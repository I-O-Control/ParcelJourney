@page "/"
@model ParcelJourney.App.Pages.IndexModel
@{ Layout = null; }
@Html.Raw(Model.Viewer)
<style>#live-query{position:fixed;left:12px;right:12px;bottom:12px;z-index:9;padding:10px 12px;border:1px solid #435778;border-radius:10px;background:#142338f2;color:#e2e8f0;box-shadow:0 8px 24px #0005}#live-query-form{display:flex;gap:8px;align-items:center;flex-wrap:wrap}#live-query input{min-width:180px;padding:7px;border:1px solid #435778;border-radius:6px;background:#243250;color:inherit}#live-query button{padding:7px 12px;border:1px solid #f07840;border-radius:6px;background:#50342d;color:inherit}#live-status{color:#ffbd9a}#live-result{max-height:220px;overflow:auto;white-space:pre-wrap;background:#0f172af5;padding:10px;border-radius:6px;margin:8px 0 0}@@media(max-width:700px){#live-query{position:relative;left:auto;right:auto;bottom:auto;margin:8px}}
</style>
<script>(()=>{const form=document.getElementById('live-query-form'),status=document.getElementById('live-status'),out=document.getElementById('live-result'),logs=document.getElementById('live-logs');document.getElementById('pick-logs')?.addEventListener('click',async()=>{const r=await fetch('/api/pick-folder');if(r.status===204)return;const d=await r.json();if(d.path)logs.value=d.path});fetch('/api/index/status').then(r=>r.json()).then(d=>document.getElementById('index-status').textContent=d.status).catch(()=>{});form?.addEventListener('submit',async e=>{e.preventDefault();status.textContent='Reading indexed logs…';out.hidden=true;const q=new URLSearchParams({logs:logs.value,id:document.getElementById('live-id').value,pattern:document.getElementById('live-pattern').value});try{const r=await fetch('/api/journey?'+q);const data=await r.json();if(!r.ok)throw new Error(data.error||'Read failed');out.textContent=JSON.stringify(data,null,2);out.hidden=false;status.textContent=`${data.Events?.length||0} events read from the selected folder.`}catch(err){status.textContent=err.message}})})();</script>

<style>
  /* Presentation-layer enhancements for the replay viewer. The generated viewer remains the source of truth for data and controls. */
  #parcel { transition: none; transform-box: fill-box; }
  #parcel circle { animation: pj-parcel-pulse 1.35s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  #pipes .shine, #trail .history { animation: none; }
  #pipes .shine.pj-active-flow { stroke-dasharray: 12 28; animation: pj-flow 1.5s linear infinite; }
  #trail .liquid { filter: none; }
  .station.pj-active rect:nth-child(2) { animation: pj-station-pulse 1.1s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .station.pj-active path { stroke: #fff !important; stroke-opacity: .9; }
  .stage[data-pj-state="recirculation"] #parcel circle { fill: #f59e0b !important; }
  .stage[data-pj-state="held"] #parcel circle { fill: #fbbf24 !important; animation-duration: .75s; }
  .stage[data-pj-state="exception"] #parcel circle { fill: #ef4444 !important; animation-duration: .55s; }
  .stage[data-pj-state="completed"] #parcel circle { fill: #22c55e !important; animation-duration: 2s; }
  .pj-hud { position: absolute; top: 12px; right: 12px; z-index: 3; display: flex; align-items: center; gap: 8px; max-width: min(420px, 55%); padding: 8px 11px; border: 1px solid var(--line, #435778); border-radius: 999px; background: var(--label-bg, rgba(20,35,56,.95)); color: var(--text, #e2e8f0); box-shadow: 0 5px 18px #0003; font-size: 12px; pointer-events: none; }
  .pj-hud-dot { width: 8px; height: 8px; flex: 0 0 auto; border-radius: 50%; background: #f07840; box-shadow: 0 0 0 4px #f0784033; }
  .stage[data-pj-state="recirculation"] .pj-hud-dot { background: #f59e0b; box-shadow: 0 0 0 4px #f59e0b33; }
  .stage[data-pj-state="held"] .pj-hud-dot { background: #fbbf24; box-shadow: 0 0 0 4px #fbbf2433; }
  .stage[data-pj-state="exception"] .pj-hud-dot { background: #ef4444; box-shadow: 0 0 0 4px #ef444433; }
  .stage[data-pj-state="completed"] .pj-hud-dot { background: #22c55e; box-shadow: 0 0 0 4px #22c55e33; }
  .pj-hud-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @@keyframes pj-flow { to { stroke-dashoffset: -40px; } }
  @@keyframes pj-parcel-pulse { 0%, 100% { opacity: .22; transform: scale(.9); } 50% { opacity: .6; transform: scale(1.16); } }
  @@keyframes pj-station-pulse { 0%, 100% { filter: drop-shadow(0 0 2px currentColor); } 50% { filter: drop-shadow(0 0 10px currentColor); } }
  @@media (prefers-reduced-motion: reduce) {
    #parcel, #pipes .shine, #trail .history, #parcel circle, .station.pj-active rect:nth-child(2) { animation: none !important; transition: none !important; }
  }
</style>

<script>
  (() => {
    const stage = document.getElementById('stage');
    const map = document.getElementById('map');
    const parcel = document.getElementById('parcel');
    const events = document.getElementById('events');
    const pick = document.getElementById('pick');
    if (!stage || !map || !parcel || !events || !pick) return;

    const reducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    const hud = document.createElement('div');
    hud.className = 'pj-hud';
    const dot = document.createElement('span');
    dot.className = 'pj-hud-dot';
    const label = document.createElement('span');
    label.className = 'pj-hud-label';
    hud.append(dot, label);
    stage.append(hud);

    const statusFor = (event, parcelData, done) => {
      const text = `${event?.Summary || ''} ${done ? parcelData?.outcome || '' : ''}`.toLowerCase();
      if (/noread|\bpf\b|\bnd\b|\bnio\b|exception|unresolved|wrong|missing|invalid/.test(text)) return 'exception';
      if (/recirculation|retry|loop|no compatible|unavailable/.test(text)) return 'recirculation';
      if (/held|waiting/.test(text)) return 'held';
      if (/completed/.test(text)) return 'completed';
      return 'active';
    };

    const syncVisualState = () => {
      const replay = window.replayTest;
      if (!replay?.model) return;
      const parcelData = replay.model.parcels[Number(pick.value)] || replay.model.parcels[0];
      const active = events.querySelector('.event.active');
      const index = active ? Number(active.dataset.i) : 0;
      const event = parcelData?.events[index] || parcelData?.events[0];
      const node = replay.model.nodes.find(n => n.id === event?.LocationId);
      const done = Number(replay.state?.t || 0) >= Number(parcelData?.duration || 0);
      const state = statusFor(event, parcelData, done);
      const leg = parcelData?.legs.find(l => replay.state.t >= l.start && replay.state.t < l.end);
      const edgeIndex = leg ? replay.model.edges.findIndex(edge => edge.id === leg.edges[0]) : -1;
      activeStation?.classList.remove('pj-active');
      activeShine?.classList.remove('pj-active-flow');
      activeStation = node ? stationByLabel.get(node.label) : undefined;
      activeShine = edgeIndex >= 0 ? shinePaths[edgeIndex] : undefined;
      activeStation?.classList.add('pj-active');
      activeShine?.classList.add('pj-active-flow');
      stage.dataset.pjState = state;
      label.textContent = `${state.toUpperCase()} · ${node?.label || 'Replay'}`;
    };

    const stationByLabel = new Map([...document.querySelectorAll('.station')].map(el => [el.getAttribute('aria-label'), el]));
    const shinePaths = [...document.querySelectorAll('#pipes .shine')];
    let activeStation;
    let activeShine;
    window.setInterval(syncVisualState, 160);
    syncVisualState();
  })();
</script>
