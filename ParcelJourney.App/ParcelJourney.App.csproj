<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ParcelJourney</AssemblyName>
    <RootNamespace>ParcelJourney.App</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="LayoutEditor.html" LogicalName="ParcelJourney.Layout.Html" />
    <EmbeddedResource Include="LayoutEditor.js" LogicalName="ParcelJourney.Layout.Js" />
    <ProjectReference Include="..\ParcelJourney.Core\ParcelJourney.Core.csproj" />
    <EmbeddedResource Include="Viewer3d\theme.css" LogicalName="ParcelJourney.Theme" />
    <EmbeddedResource Include="Viewer3d\index.html" LogicalName="ParcelJourney.3d.Html" />
    <EmbeddedResource Include="Viewer3d\viewer.css" LogicalName="ParcelJourney.3d.Css" />
    <EmbeddedResource Include="Viewer3d\viewer.js" LogicalName="ParcelJourney.3d.Js" />
    <EmbeddedResource Include="Viewer3d\THREE-LICENSE.txt" LogicalName="ParcelJourney.3d.License" />
    <EmbeddedResource Include="Assets\journey-browser.js" LogicalName="ParcelJourney.Folder.Js" />
    <EmbeddedResource Include="Assets\journey-browser.css" LogicalName="ParcelJourney.Folder.Css" />
    <EmbeddedResource Include="Assets\replay-model.json" LogicalName="ParcelJourney.3d.Model" />
    <EmbeddedResource Include="Assets\equipment-replay.html" LogicalName="ParcelJourney.Viewer" />
    <EmbeddedResource Include="Assets\replay-validation.json" LogicalName="ParcelJourney.Validation" />
  </ItemGroup>
</Project>
