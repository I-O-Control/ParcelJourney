@page "/plugins/parcel-journey"
@rendermode InteractiveServer
@attribute [Authorize(Policy = ParcelJourneyModule.PageKey)]

<PageTitle>Parcel Journey</PageTitle>

<div class="parcel-journey-host">
    <iframe id="parcel-journey-viewer"
            title="Parcel Journey replay viewer"
            src="about:blank"
            data-view="2d"
            style="visibility:hidden"></iframe>
</div>

<style>
    .parcel-journey-host {
        position: relative;
        width: 100%;
        height: calc(100dvh - 6.75rem);
        min-height: 0;
        margin: 0;
        overflow: hidden;
        background: var(--bs-body-bg, #101820);
    }

    .parcel-journey-host iframe {
        display: block;
        width: 100%;
        height: 100%;
        min-height: 0;
        border: 0;
        overflow: hidden;
    }
</style>

<script>
(() => {
    const assetVersion = '20260924.6';
    const hostTheme = () => {
        const root = document.documentElement;
        return root.getAttribute('data-theme') === 'light' ||
               root.getAttribute('data-bs-theme') === 'light' ||
               document.body.classList.contains('light') ? 'light' : 'dark';
    };
    const sync = () => {
        const frame = document.getElementById('parcel-journey-viewer');
        if (!frame) return;
        const view = frame.dataset.view === '3d' ? '3d' : '2d';
        const target = `${window.location.origin}/_content/ParcelJourney.IocPlugin/demo/${view}/index.html?v=${assetVersion}&theme=${hostTheme()}`;
        if (frame.src !== target) {
            frame.style.visibility = 'hidden';
            frame.src = target;
        }
    };
    const fitToHostViewport = () => {
        const host = document.querySelector('.parcel-journey-host');
        if (!host) return;
        const top = host.getBoundingClientRect().top;
        const footer = document.querySelector('footer,[role="contentinfo"]');
        const footerTop = footer?.getBoundingClientRect().top;
        const bottom = footerTop && footerTop > top ? footerTop - 8 : window.innerHeight - 12;
        host.style.height = `${Math.max(360, Math.floor(bottom - Math.max(top, 0)))}px`;
    };
    new MutationObserver(sync).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'data-bs-theme'] });
    window.addEventListener('resize', fitToHostViewport);
    window.addEventListener('message', event => {
        if (event.data?.type !== 'parcel-journey-view') return;
        const frame = document.getElementById('parcel-journey-viewer');
        if (frame) {
            frame.dataset.view = event.data.view === '3d' ? '3d' : '2d';
            frame.style.visibility = 'hidden';
        }
    });
    document.getElementById('parcel-journey-viewer')?.addEventListener('load', () => {
        sync();
        requestAnimationFrame(() => document.getElementById('parcel-journey-viewer').style.visibility = 'visible');
    });
    requestAnimationFrame(fitToHostViewport);
    sync();
})();
</script>
